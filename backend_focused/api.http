@baseUrl = http://localhost:8000/api
@username = admin
@password = change-me
@accessToken = paste-access-token-here
@refreshToken = paste-refresh-token-here
@officeId = 1
@newOfficeId = 2
@vehicleId = 1
@mechanicId = 1
@maintenanceRecordId = 1

### Obtain access and refresh tokens
POST {{baseUrl}}/token/
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

### Refresh the access token
POST {{baseUrl}}/token/refresh/
Content-Type: application/json

{
  "refresh": "{{refreshToken}}"
}

### List offices
GET {{baseUrl}}/offices/
Authorization: Bearer {{accessToken}}

### Create office
POST {{baseUrl}}/offices/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Salvador Office",
  "city": "Salvador"
}

### Get office
GET {{baseUrl}}/offices/{{officeId}}/
Authorization: Bearer {{accessToken}}

### Update office
PATCH {{baseUrl}}/offices/{{officeId}}/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "city": "Feira de Santana"
}

### Delete office
DELETE {{baseUrl}}/offices/{{officeId}}/
Authorization: Bearer {{accessToken}}

### Office summary
GET {{baseUrl}}/offices/summary/
Authorization: Bearer {{accessToken}}

### List vehicles
GET {{baseUrl}}/vehicles/
Authorization: Bearer {{accessToken}}

### Search vehicles
GET {{baseUrl}}/vehicles/?office={{officeId}}&active=true&make=Toyota&model=Corolla&maintenance_date_after=2025-01-01&maintenance_date_before=2026-12-31&mechanic_certification_number=CERT-00001
Authorization: Bearer {{accessToken}}

### Create vehicle
POST {{baseUrl}}/vehicles/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "vin": "1HGCM82633A004352",
  "license_plate": "ABC-1234",
  "make": "Honda",
  "model": "Accord",
  "year": 2022,
  "office": {{officeId}},
  "active": true
}

### Vehicle details
GET {{baseUrl}}/vehicles/{{vehicleId}}/
Authorization: Bearer {{accessToken}}

### Update vehicle
PATCH {{baseUrl}}/vehicles/{{vehicleId}}/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "active": false
}

### Delete vehicle
DELETE {{baseUrl}}/vehicles/{{vehicleId}}/
Authorization: Bearer {{accessToken}}

### Paginated vehicle maintenance history
GET {{baseUrl}}/vehicles/{{vehicleId}}/maintenance-history/?page=1
Authorization: Bearer {{accessToken}}

### Assign vehicle to another office
POST {{baseUrl}}/vehicles/{{vehicleId}}/assign-office/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "office": {{newOfficeId}}
}

### Vehicles needing maintenance
GET {{baseUrl}}/vehicles/needing-maintenance/?page=1
Authorization: Bearer {{accessToken}}

### Check vehicle conflicts
POST {{baseUrl}}/vehicles/duplicate-check/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "vin": "1HGCM82633A004352",
  "license_plate": "ABC-1234"
}

### List mechanics
GET {{baseUrl}}/mechanics/
Authorization: Bearer {{accessToken}}

### Create mechanic
POST {{baseUrl}}/mechanics/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Jane Smith",
  "certification_number": "ASE-001",
  "active": true
}

### Get mechanic
GET {{baseUrl}}/mechanics/{{mechanicId}}/
Authorization: Bearer {{accessToken}}

### Update mechanic
PATCH {{baseUrl}}/mechanics/{{mechanicId}}/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "active": false
}

### Delete mechanic
DELETE {{baseUrl}}/mechanics/{{mechanicId}}/
Authorization: Bearer {{accessToken}}

### Mechanic workload
GET {{baseUrl}}/mechanics/workload/
Authorization: Bearer {{accessToken}}

### List maintenance records
GET {{baseUrl}}/maintenance-records/
Authorization: Bearer {{accessToken}}

### Create maintenance record
POST {{baseUrl}}/maintenance-records/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "vehicle": {{vehicleId}},
  "mechanic": {{mechanicId}},
  "maintenance_date": "2026-09-28",
  "maintenance_type": "Oil change",
  "cost": "125.50",
  "notes": "Synthetic oil"
}

### Get maintenance record
GET {{baseUrl}}/maintenance-records/{{maintenanceRecordId}}/
Authorization: Bearer {{accessToken}}

### Update maintenance record
PATCH {{baseUrl}}/maintenance-records/{{maintenanceRecordId}}/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "cost": "150.00"
}

### Delete maintenance record
DELETE {{baseUrl}}/maintenance-records/{{maintenanceRecordId}}/
Authorization: Bearer {{accessToken}}
